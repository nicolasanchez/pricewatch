# Copia este archivo como .env y rellénalo. Nunca subas .env a GitHub.

DEBUG=1
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
# En producción, la URL pública: CSRF_TRUSTED_ORIGINS=https://pricewatch.nicosantor.com
CSRF_TRUSTED_ORIGINS=

# PostgreSQL. Con Docker Compose ya viene puesta; en Render, la cadena de conexión de Neon.
DATABASE_URL=postgres://pricewatch:pricewatch@db:5432/pricewatch

SITE_URL=http://localhost:8000
CONTACT_EMAIL=contacto@nicosantor.com

# Correo (sin rellenar, los correos se muestran en la consola)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=PriceWatch <avisos@nicosantor.com>
# none | optional | mandatory
ACCOUNT_EMAIL_VERIFICATION=none

# Inicio de sesión con Google (Google Cloud Console > Credenciales > ID de cliente OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Inicio de sesión con Apple (requiere cuenta de Apple Developer de pago)
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_PRIVATE_KEY=
